---
import '../styles/global.css';
import { MAX_ITEMS } from '../contributions.js';

const title = 'GitHub OSS Card — Show off your open source contributions';
const description = 'Build an animated SVG card of your open source pull requests for your GitHub README. No token, no sign-in.';
const origin = 'https://github-oss-card.vercel.app';
const keywords = ['Merged PRs', 'Open source', 'GitHub README', 'Animated SVG', 'Stars', 'Themes', 'No token', 'Profile card'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f1b2a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${origin}/`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <header class="site-header shell">
      <a class="brand" href="/" aria-label="GitHub OSS Card home">
        <img class="brand-logo" src="/favicon.svg" width="36" height="36" alt="" />
        <span>OSS Card</span>
      </a>
      <a class="github-link" href="https://github.com/Seungpyo1007/github-oss-card" rel="noopener">
        <span>View on GitHub</span><span aria-hidden="true">↗</span>
      </a>
    </header>

    <main class="shell">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">OPEN SOURCE · SVG CARD</p>
        <h1 id="page-title"><span>Your merged PRs,</span><span class="gradient-text">on your profile.</span></h1>
        <p class="hero-copy">
          List the pull requests you are proud of, style the card, and paste one line into your GitHub README.
        </p>
        <div class="hero-metrics" aria-label="Project highlights">
          <span><strong>{MAX_ITEMS}</strong><small>contributions per card</small></span>
          <span><strong>3</strong><small>themes</small></span>
          <span><strong>0</strong><small>tokens needed</small></span>
        </div>
        <div class="keyword-marquee" aria-hidden="true">
          <div class="marquee-track">
            {[0, 1].map(() => keywords.map((keyword) => (<><span>{keyword}</span><i>◆</i></>)))}
          </div>
        </div>
      </section>

      <div class="workspace">
        <div class="editor-column">
          <section class="panel reveal" aria-labelledby="style-title">
            <p class="step-label">STEP 1</p>
            <h2 id="style-title">Style</h2>
            <div class="field-grid">
              <label class="field field-wide">Card title
                <input id="title" value="Open Source Contributions" maxlength="48" autocomplete="off" />
              </label>
              <div class="field field-wide">Theme
                <div class="segmented" role="radiogroup" aria-label="Theme">
                  <label><input type="radio" name="theme" value="shiny" checked /><span><i class="swatch swatch-shiny"></i>shiny</span></label>
                  <label><input type="radio" name="theme" value="github_dark" /><span><i class="swatch swatch-dark"></i>github_dark</span></label>
                  <label><input type="radio" name="theme" value="light" /><span><i class="swatch swatch-light"></i>light</span></label>
                </div>
              </div>
              <label class="toggle"><input type="checkbox" id="hide-title" /><span></span>Hide title</label>
              <label class="toggle"><input type="checkbox" id="animation" checked /><span></span>Animation</label>
            </div>
          </section>

          <section class="panel reveal" aria-labelledby="items-title">
            <div class="panel-heading">
              <div>
                <p class="step-label">STEP 2</p>
                <h2 id="items-title">Contributions</h2>
              </div>
              <span class="counter" id="counter"></span>
            </div>
            <ol class="item-list" id="item-list"></ol>
            <button class="add-button" id="add-item" type="button"><span aria-hidden="true">＋</span> Add contribution</button>
            <p class="hint">Only the repository is required. Everything is stored in the card URL, so nothing is saved on a server.</p>
          </section>
        </div>

        <section class="panel preview-panel reveal" aria-labelledby="preview-title">
          <p class="step-label">STEP 3</p>
          <h2 id="preview-title">Preview &amp; copy</h2>
          <div class="preview-stage" id="preview-stage">
            <img id="preview" alt="Open source contributions card preview" />
          </div>
          <div class="output-field">
            <input id="markdown" readonly aria-label="Markdown snippet" />
            <button class="copy-button" id="copy" type="button">Copy</button>
          </div>
          <p class="hint">GitHub caches README images. Change <code>&amp;v=1</code> to <code>&amp;v=2</code> after editing to refresh it.</p>
        </section>
      </div>
    </main>

    <template id="item-template">
      <li class="item">
        <div class="item-header">
          <span class="item-index"></span>
          <div class="item-actions">
            <button type="button" data-action="up" aria-label="Move up">↑</button>
            <button type="button" data-action="down" aria-label="Move down">↓</button>
            <button type="button" data-action="remove" aria-label="Remove">✕</button>
          </div>
        </div>
        <div class="item-grid">
          <label class="field item-repo">Repository
            <input data-field="repo" placeholder="owner/repo" autocomplete="off" spellcheck="false" />
          </label>
          <label class="field">PR #
            <input data-field="number" inputmode="numeric" placeholder="342" autocomplete="off" />
          </label>
          <label class="field item-title">Title
            <input data-field="title" maxlength="100" placeholder="feat: what you changed" autocomplete="off" />
          </label>
          <label class="field">Stars
            <input data-field="stars" inputmode="numeric" placeholder="29157" autocomplete="off" />
          </label>
          <label class="field">Date
            <input data-field="date" type="date" />
          </label>
          <label class="field">Status
            <select data-field="status">
              <option value="merged">merged</option>
              <option value="open">open</option>
            </select>
          </label>
        </div>
      </li>
    </template>

    <footer class="site-footer">
      MIT · Made by <a href="https://github.com/Seungpyo1007">Seungpyo1007</a> · Sibling of
      <a href="https://github-tech-stack-card.vercel.app">Tech Stack Card</a>
    </footer>

    <script>
      import '../ui/builder.js';
    </script>
  </body>
</html>
