---
import '../styles/global.css';

const title = 'GitHub OSS Card — Show your open source contributions';
const description = 'A live SVG card of the pull requests you got merged into other people’s projects, for your GitHub README.';
const origin = 'https://github-oss-card.vercel.app';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f1b2a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${origin}/`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <header class="site-header shell">
      <a class="brand" href="/" aria-label="GitHub OSS Card home">
        <img class="brand-logo" src="/favicon.svg" width="36" height="36" alt="" />
        <span>OSS Card</span>
      </a>
      <a class="github-link" href="https://github.com/Seungpyo1007/github-oss-card" rel="noopener">
        <span>View on GitHub</span><span aria-hidden="true">↗</span>
      </a>
    </header>

    <main class="shell">
      <section class="hero">
        <p class="eyebrow">OPEN SOURCE · SVG CARD</p>
        <h1><span>Your merged PRs,</span><span class="gradient-text">on your profile.</span></h1>
        <p class="hero-copy">
          Pull requests you landed in other people’s projects, found automatically and drawn as one card.
          Your own repositories and organizations are left out.
        </p>
      </section>

      <section class="panel" aria-labelledby="builder-title">
        <h2 id="builder-title">Build your card</h2>
        <form class="field-grid" id="builder">
          <label class="field">GitHub username
            <input name="username" value="Seungpyo1007" autocomplete="off" spellcheck="false" required pattern="[A-Za-z0-9-]{1,39}" />
          </label>
          <label class="field">Theme
            <select name="theme">
              <option value="shiny">shiny</option>
              <option value="github_dark">github_dark</option>
              <option value="light">light</option>
            </select>
          </label>
          <label class="field">Minimum stars
            <input name="min_stars" type="number" min="0" value="10" />
          </label>
          <label class="field">Max items
            <input name="limit" type="number" min="1" max="10" value="6" />
          </label>
        </form>
      </section>

      <section class="panel" aria-labelledby="preview-title">
        <h2 id="preview-title">Preview</h2>
        <div class="preview-stage">
          <img id="preview" src="/api/card?username=Seungpyo1007" alt="Open source contributions card preview" />
        </div>
        <div class="output-field" style="margin-top: 18px">
          <input id="markdown" readonly aria-label="Markdown snippet" />
          <button class="button-accent" id="copy" type="button">Copy</button>
        </div>
        <p class="hint">The card is cached for six hours. Add or change <code>&amp;v=2</code> in the URL to refresh it on GitHub.</p>
      </section>
    </main>

    <footer class="site-footer">
      MIT · Made by <a href="https://github.com/Seungpyo1007">Seungpyo1007</a> · Sibling of
      <a href="https://github-tech-stack-card.vercel.app">Tech Stack Card</a>
    </footer>

    <script is:inline define:vars={{ origin }}>
      const form = document.getElementById('builder');
      const preview = document.getElementById('preview');
      const markdown = document.getElementById('markdown');
      const copy = document.getElementById('copy');
      let timer;

      function cardUrl() {
        const data = new FormData(form);
        const params = new URLSearchParams();
        params.set('username', String(data.get('username') || 'Seungpyo1007').trim());
        if (data.get('theme') !== 'shiny') params.set('theme', String(data.get('theme')));
        if (data.get('min_stars') !== '10') params.set('min_stars', String(data.get('min_stars')));
        if (data.get('limit') !== '6') params.set('limit', String(data.get('limit')));
        return `${origin}/api/card?${params}`;
      }

      function update() {
        const url = cardUrl();
        markdown.value = `![Open source contributions](${url})`;
        clearTimeout(timer);
        timer = setTimeout(() => { preview.src = url.replace(origin, ''); }, 350);
      }

      form.addEventListener('input', update);
      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(markdown.value);
        copy.textContent = 'Copied';
        setTimeout(() => { copy.textContent = 'Copy'; }, 1400);
      });
      update();
    </script>
  </body>
</html>
